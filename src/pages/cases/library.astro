---
import Base from '../../layouts/Base.astro';
import HydrateCache from '../../components/HydrateCache.astro';
import CasesLibrary from '../../components/islands/CasesLibrary';
---

<Base title="用例管理 · Lantern Harness">
  <div class="tw-library-page tw-library-wide px-8 py-8">
    <header class="mb-6 shrink-0">
      <h1 class="text-2xl font-bold text-stone-900">用例管理</h1>
      <p class="mt-2 text-sm text-stone-500">
        以列表管理用例文件；可跳转我的工作台生成，双击本地打开，支持删除。
      </p>
    </header>
    <div class="tw-hydrate-host">
      <CasesLibrary client:only="react" />
      <HydrateCache host=".tw-hydrate-host" name="cases" capture />
    </div>
  </div>
</Base>
