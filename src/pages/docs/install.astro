---
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import path from 'node:path';
import Docs from '../../layouts/Docs.astro';
import { renderDoc, stripFirstH1 } from '../../lib/docs-md';

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../..');
const md = readFileSync(path.join(root, 'docs/安装手册.md'), 'utf8');
const { html, toc } = renderDoc(stripFirstH1(md));
---

<Docs title="安装手册 · Lantern Harness" active="install" toc={toc}>
  <article class="tw-docs-article">
    <header class="tw-docs-article-hero">
      <h1 class="tw-docs-article-title" data-i18n="docs.nav.install">
        安装手册
      </h1>
      <p class="tw-docs-article-lead">npm 一体服务与源码启动的安装、初始化与常用命令。</p>
    </header>
    <div class="tw-docs-prose" set:html={html} />
  </article>
</Docs>
