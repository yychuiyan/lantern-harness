---
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import path from 'node:path';
import { marked } from 'marked';
import Docs from '../../layouts/Docs.astro';
import { withBlankExternalLinks } from '../../lib/docs-md';

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../..');
const md = readFileSync(path.join(root, 'CHANGELOG.md'), 'utf8');

/** 去掉首个 H1 与其后可能存在的导语，只保留以 ## 开头的版本块（无导语时第二步为空操作） */
const bodyMd = md.replace(/^#\s+[^\n]+\n+/, '');
const versionsMd = bodyMd.replace(/^[\s\S]*?(?=^##\s)/m, '').trim();

type VersionBlock = {
  titleHtml: string;
  summaryHtml: string;
  detailHtml: string;
  hasDetail: boolean;
};

/** 去掉标题里的行内 markdown 修饰，只留纯文本用于概览 */
function plainHeading(text: string): string {
  return text
    .replace(/[`*_~]/g, '')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .trim();
}

/**
 * 没有导语时按小节统计生成一句概览。
 * 版本块通常直接以 `### 变更` / `### 修复` 开头，卡片里只剩标题会显得空。
 */
function buildDefaultSummary(detailMd: string): string {
  const sections: Array<{ name: string; count: number }> = [];
  let current: { name: string; count: number } | null = null;
  let loose = 0;
  for (const raw of detailMd.split('\n')) {
    const line = raw.trim();
    if (/^###\s+/.test(line)) {
      current = { name: plainHeading(line.replace(/^###\s+/, '')), count: 0 };
      sections.push(current);
      continue;
    }
    if (/^##\s+/.test(line)) {
      current = null;
      continue;
    }
    if (!/^[-*]\s+/.test(line)) continue;
    if (current) current.count += 1;
    else loose += 1;
  }
  const named = sections.filter((s) => s.count > 0).map((s) => `${s.name} ${s.count} 项`);
  if (named.length) {
    if (loose > 0) named.push(`其它 ${loose} 项`);
    return `本次更新包含：${named.join('、')}。`;
  }
  if (loose > 0) return `本次更新包含 ${loose} 项改动。`;
  return '本版本暂无详细描述。';
}

function splitVersionBlocks(src: string): VersionBlock[] {
  if (!src.trim()) return [];
  const chunks = src.split(/(?=^##\s)/m).filter((c) => c.trim());
  return chunks.map((chunk) => {
    const lines = chunk.replace(/\r\n/g, '\n').split('\n');
    const titleLine = lines[0] ?? '';
    const rest = lines.slice(1);
    let i = 0;
    while (i < rest.length && !rest[i]!.trim()) i++;
    const summaryLines: string[] = [];
    if (i < rest.length && !rest[i]!.startsWith('#')) {
      while (i < rest.length && rest[i]!.trim() && !rest[i]!.startsWith('#')) {
        summaryLines.push(rest[i]!);
        i++;
      }
    }
    while (i < rest.length && !rest[i]!.trim()) i++;
    const detailMd = rest.slice(i).join('\n').trim();
    const titleHtml = marked.parse(titleLine, { async: false }) as string;
    const detailHtml = detailMd
      ? withBlankExternalLinks(marked.parse(detailMd, { async: false }) as string)
      : '';
    // 有导语就用导语；没有则按小节统计生成概览，避免卡片只剩标题
    const summaryMd = summaryLines.length ? summaryLines.join('\n') : buildDefaultSummary(detailMd);
    const summaryHtml = marked.parse(summaryMd, { async: false }) as string;
    return {
      titleHtml,
      summaryHtml,
      detailHtml,
      hasDetail: Boolean(detailHtml),
    };
  });
}

const versions = splitVersionBlocks(versionsMd);
---

<Docs title="版本日志 · Lantern Harness" active="changelog">
  <div class="tw-changelog">
    <header class="tw-changelog-hero">
      <h1 class="tw-changelog-title" data-i18n="docs.nav.changelog">
        版本日志
      </h1>
      <p class="tw-changelog-lead">记录 Lantern Harness 平台的版本演进与重要变更。</p>
    </header>

    <div class="tw-changelog-list tw-anim-list">
      {versions.map((v) => (
        <section class="tw-changelog-card" data-open="false">
          <div class="tw-changelog-card-head" set:html={v.titleHtml} />
          {v.summaryHtml ? (
            <div class="tw-changelog-card-summary" set:html={v.summaryHtml} />
          ) : null}
          {v.hasDetail ? (
            <>
              <div class="tw-changelog-card-detail-wrap">
                <div class="tw-changelog-card-detail" set:html={v.detailHtml} />
              </div>
              <div class="tw-changelog-toggle-row">
                <button type="button" class="tw-changelog-toggle" aria-expanded="false">
                  <span class="tw-changelog-toggle-label">查看更多</span>
                  <svg
                    class="tw-changelog-toggle-arrow"
                    viewBox="0 0 16 16"
                    width="14"
                    height="14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M6 3.5 L10.5 8 L6 12.5" />
                  </svg>
                </button>
              </div>
            </>
          ) : null}
        </section>
      ))}
    </div>
  </div>
</Docs>

<style>
  .tw-changelog {
    padding: 2.5rem 2rem 4rem;
  }

  .tw-changelog-hero {
    margin-bottom: 1.75rem;
  }

  .tw-changelog-title {
    margin: 0;
    font-size: 1.85rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--tw-label-primary);
  }

  .tw-changelog-lead {
    margin: 0.75rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--tw-label-secondary);
  }

  .tw-changelog-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .tw-changelog-card {
    background: var(--tw-surface-panel);
    border: 1px solid var(--tw-border);
    border-radius: 14px;
    padding: 1.25rem 1.5rem 1rem;
    box-shadow: 0 1px 0 rgba(16, 24, 40, 0.02);
  }

  .tw-changelog-card-head :global(h2) {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--tw-label-primary);
  }

  .tw-changelog-card-head :global(h2 a) {
    color: inherit;
    text-decoration: none;
  }

  .tw-changelog-card-head :global(h2 a:hover) {
    color: var(--tw-accent);
  }

  .tw-changelog-card-summary :global(p) {
    margin: 0.65rem 0 0;
    color: var(--tw-label-secondary);
    line-height: 1.65;
    font-size: 0.9375rem;
  }

  .tw-changelog-card-detail-wrap {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    margin-top: 0;
    transition:
      grid-template-rows 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.24s ease,
      margin-top 0.32s ease;
  }

  .tw-changelog-card[data-open='true'] .tw-changelog-card-detail-wrap {
    grid-template-rows: 1fr;
    opacity: 1;
    margin-top: 0.35rem;
  }

  .tw-changelog-card-detail {
    overflow: hidden;
    min-height: 0;
  }

  .tw-changelog-card-detail :global(h3) {
    margin: 1rem 0 0.4rem;
    font-size: 0.8125rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--tw-accent);
  }

  .tw-changelog-card-detail :global(h4) {
    margin: 0.85rem 0 0.35rem;
    font-size: 0.875rem;
    font-weight: 650;
    color: var(--tw-label-primary);
  }

  .tw-changelog-card-detail :global(ul) {
    /* Tailwind preflight 会把 ul 的 list-style 清成 none，这里显式加回圆点 */
    list-style: disc;
    margin: 0.35rem 0 0.75rem;
    padding-left: 1.15rem;
    color: var(--tw-label-secondary);
  }

  .tw-changelog-card-detail :global(li) {
    margin: 0.35rem 0;
    line-height: 1.6;
  }

  .tw-changelog-card-detail :global(li::marker) {
    color: color-mix(in srgb, var(--tw-accent) 70%, var(--tw-label-tertiary));
  }

  .tw-changelog-card-detail :global(p) {
    margin: 0.5rem 0;
    color: var(--tw-label-secondary);
    line-height: 1.65;
  }

  .tw-changelog-card-detail :global(a) {
    color: var(--tw-accent);
    text-decoration: none;
  }

  .tw-changelog-card-detail :global(a:hover) {
    text-decoration: underline;
  }

  .tw-changelog-card-detail :global(code) {
    font-size: 0.85em;
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--tw-accent-soft);
    color: var(--tw-accent);
  }

  .tw-changelog-toggle-row {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.65rem;
  }

  .tw-changelog-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0;
    border: none;
    background: none;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--tw-accent);
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .tw-changelog-toggle:hover {
    opacity: 0.88;
  }

  .tw-changelog-toggle:hover .tw-changelog-toggle-label {
    text-decoration: underline;
  }

  .tw-changelog-toggle-arrow {
    display: block;
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tw-changelog-card[data-open='true'] .tw-changelog-toggle-arrow {
    transform: rotate(90deg);
  }
</style>
