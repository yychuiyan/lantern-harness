---
import Base from '../layouts/Base.astro';
import HydrateCache from '../components/HydrateCache.astro';
import TasksBoard from '../components/islands/TasksBoard';
---

<Base title="任务管理 · Lantern Harness">
  <div class="tw-library-page tw-library-wide px-8 py-8">
    <header class="mb-6 shrink-0">
      <h1 class="text-2xl font-bold text-stone-900">任务管理</h1>
      <p class="mt-2 text-sm text-stone-500">
        用任务把待办分组：任务下关联的待办数量与完成进度会自动汇总。
      </p>
    </header>
    <div class="tw-hydrate-host">
      <TasksBoard client:only="react" />
      <HydrateCache host=".tw-hydrate-host" name="tasks" capture />
    </div>
  </div>
</Base>
