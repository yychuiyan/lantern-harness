---
import Base from '../../layouts/Base.astro';
import HydrateCache from '../../components/HydrateCache.astro';
import { getCollection } from 'astro:content';
import KnowledgeLibrary from '../../components/islands/KnowledgeLibrary';

const base = import.meta.env.BASE_URL;
const entries = await getCollection('knowledge');
---

<Base title="知识库管理 · Lantern Harness">
  <div class="tw-library-page px-8 py-8">
    <header class="mb-6 shrink-0">
      <h1 class="text-2xl font-bold text-stone-900">知识库管理</h1>
      <p class="mt-2 text-sm text-stone-500">以列表管理测试规范 / 方法论 / 环境约定（.md）。</p>
    </header>
    <div class="tw-hydrate-host">
      <KnowledgeLibrary client:only="react" base={base} staticCount={entries.length} />
      <HydrateCache host=".tw-hydrate-host" name="knowledge" capture />
    </div>
  </div>
</Base>
