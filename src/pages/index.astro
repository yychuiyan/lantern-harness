---
/**
 * 应用入口：默认进「我的工作台」。
 * 自动化测试在 /test-automation/，需从侧栏进入。
 */
const base = import.meta.env.BASE_URL;
const root = base.endsWith('/') ? base : `${base}/`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lantern Harness</title>
    <link rel="icon" type="image/png" sizes="32x32" href={`${root}brand/favicon.png`} />
    <meta http-equiv="refresh" content={`0;url=${root}workbench/`} />
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        background: #faf9f7;
      }
    </style>
  </head>
  <body>
    <noscript>
      <p style="padding: 24px; font-family: sans-serif; font-size: 14px; color: #57534e">
        需要启用 JavaScript；也可以直接打开
        <a href={`${root}workbench/`}>我的工作台</a> 或
        <a href={`${root}test-automation/`}>自动化测试</a>。
      </p>
    </noscript>
    <script>
      const base = import.meta.env.BASE_URL;
      const root = base.endsWith('/') ? base : `${base}/`;
      window.location.replace(`${root}workbench/`);
    </script>
  </body>
</html>
