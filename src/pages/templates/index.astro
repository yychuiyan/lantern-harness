---
import Base from '../../layouts/Base.astro';
import HydrateCache from '../../components/HydrateCache.astro';
import TemplatesLibrary from '../../components/islands/TemplatesLibrary';
---

<Base title="测试模板库 · Lantern Harness">
  <div class="tw-library-page px-8 py-8">
    <header class="mb-6 shrink-0">
      <h1 class="text-2xl font-bold text-stone-900">测试模板库</h1>
      <p class="mt-2 text-sm text-stone-500">
        存放测试方案、用例与报告等模板，便于复用与统一产出格式。
      </p>
    </header>
    <div class="tw-hydrate-host">
      <TemplatesLibrary client:only="react" />
      <HydrateCache host=".tw-hydrate-host" name="templates" capture />
    </div>
  </div>
</Base>
