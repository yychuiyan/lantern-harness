---
import Base from '../../layouts/Base.astro';
import HydrateCache from '../../components/HydrateCache.astro';
import LifeKrTodosBoard from '../../components/islands/LifeKrTodosBoard';
---

<Base title="KR待办 · Lantern Harness">
  <div class="tw-library-page tw-library-wide px-8 py-8">
    <header class="mb-6 shrink-0">
      <h1 class="text-2xl font-bold text-stone-900">KR待办</h1>
      <p class="mt-2 text-sm text-stone-500">
        按 KR 任务拆解可执行待办；年度、季度与重要紧急程度跟随关联的 KR 任务与 Objective。
      </p>
    </header>
    <div class="tw-hydrate-host">
      <LifeKrTodosBoard client:only="react" />
      <HydrateCache host=".tw-hydrate-host" name="life-kr-todos" capture />
    </div>
  </div>
</Base>
