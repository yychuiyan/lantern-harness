---
import Base from '../layouts/Base.astro';

const message =
  Astro.props.error instanceof Error
    ? Astro.props.error.message
    : typeof Astro.props.error === 'string'
      ? Astro.props.error
      : '';

const isDev = import.meta.env.DEV;
const base = import.meta.env.BASE_URL || '/';
const home = `${base}workbench/`;
---

<Base title="出错了 · Lantern Harness">
  <div class="tw-error-page">
    <h1 class="tw-error-title">出错了</h1>
    <p class="tw-error-desc">页面暂时无法打开，请返回重试。</p>
    {isDev && message ? <pre class="tw-error-pre">{message}</pre> : null}
    <div class="tw-error-actions">
      <a href={home} class="tw-error-btn tw-error-btn--primary">
        返回工作台
      </a>
      <button type="button" class="tw-error-btn tw-error-btn--ghost" onclick="location.reload()">
        刷新
      </button>
    </div>
  </div>
</Base>

<style>
  .tw-error-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 2rem 1.25rem;
    text-align: center;
    background: var(--tw-surface-page);
  }

  .tw-error-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 650;
    color: var(--tw-label-primary);
  }

  .tw-error-desc {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--tw-label-secondary);
  }

  .tw-error-pre {
    margin: 0.25rem 0 0;
    max-width: 28rem;
    max-height: 8rem;
    overflow: auto;
    padding: 0.65rem 0.85rem;
    border-radius: 0.5rem;
    border: 1px solid var(--tw-border);
    background: color-mix(in srgb, var(--tw-surface-panel, #fff) 90%, transparent);
    font-size: 0.7rem;
    line-height: 1.5;
    text-align: left;
    color: var(--tw-label-secondary);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .tw-error-actions {
    margin-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .tw-error-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.25rem;
    padding: 0 1rem;
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 550;
    text-decoration: none;
    border: 1px solid transparent;
    cursor: pointer;
  }

  .tw-error-btn--primary {
    color: #fff;
    background: #4176e6;
  }

  .tw-error-btn--primary:hover {
    background: #3565c7;
  }

  .tw-error-btn--ghost {
    color: var(--tw-label-secondary);
    background: transparent;
    border-color: var(--tw-border);
  }

  .tw-error-btn--ghost:hover {
    color: var(--tw-label-primary);
  }
</style>
