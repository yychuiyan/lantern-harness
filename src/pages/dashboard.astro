---
import Base from '../layouts/Base.astro';
import DashboardBoard from '../components/islands/DashboardBoard';
---

<Base title="仪表盘 · Lantern Harness">
  <div class="tw-dashboard-page px-4 pb-24 pt-6 sm:px-8 sm:pt-8">
    <header class="mb-7 flex shrink-0 items-start justify-between gap-4">
      <div class="min-w-0">
        <h1 class="text-[26px] font-semibold leading-9 tracking-tight text-stone-900">仪表盘</h1>
        <p class="mt-1.5 text-sm text-stone-500">
          聚合当前空间的待办、任务与测试统计；按住卡片顶部手柄可拖动位置，拖右下角可改大小。
        </p>
      </div>
      <div id="tw-dashboard-actions" class="shrink-0 pt-1"></div>
    </header>
    <DashboardBoard client:only="react" />
  </div>
</Base>
