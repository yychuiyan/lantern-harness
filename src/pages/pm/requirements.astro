---
import Base from '../../layouts/Base.astro';
import PmPageHeader from '../../components/PmPageHeader.astro';
import PmRequirementsBoard from '../../components/islands/PmRequirementsBoard';
---

<Base title="需求管理 · Lantern Harness">
  <div class="tw-library-page tw-library-wide px-8 py-8">
    <PmPageHeader
