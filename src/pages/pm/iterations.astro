---
import Base from '../../layouts/Base.astro';
import PmPageHeader from '../../components/PmPageHeader.astro';
import PmIterationsBoard from '../../components/islands/PmIterationsBoard';
---

<Base title="迭代管理 · Lantern Harness">
  <div class="tw-library-page tw-library-wide px-8 py-8">
    <PmPageHeader
      icon="calendar"
      title="迭代管理"
      description="按项目维护迭代周期与状态；进度按开始 / 截止日期计算，逾期会在卡片上标出。"
    />
    <PmIterationsBoard client:only="react" />
  </div>
</Base>
