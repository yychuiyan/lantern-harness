---
import Base from '../layouts/Base.astro';
import HydrateCache from './HydrateCache.astro';
import CasesLibrary from './islands/CasesLibrary';

interface Props {
  title: string;
  description: string;
  fixedCaseType: 'functional' | 'api' | 'performance' | 'automation' | 'other';
}

const { title, description, fixedCaseType } = Astro.props;
---

<Base title={`${title} · Lantern Harness`}>
  <div class="tw-library-page tw-library-wide px-8 py-8">
    <header class="mb-6 shrink-0">
      <h1 class="text-2xl font-bold text-stone-900">{title}</h1>
      <p class="mt-2 text-sm text-stone-500">{description}</p>
    </header>
    <div class="tw-hydrate-host">
      <CasesLibrary client:only="react" fixedCaseType={fixedCaseType} />
      <HydrateCache host=".tw-hydrate-host" name={`cases-${fixedCaseType}`} capture />
    </div>
  </div>
</Base>
