---
/**
 * 项目管理四个页面的静态页头：图标块 + 标题 + 说明。
 * 与 luckytask 的页头层级一致（标题 lg，说明 xs 弱化），实时数量放在看板工具栏里。
 */
export type PmPageIcon = 'folder' | 'calendar' | 'file' | 'bug';

interface Props {
  icon: PmPageIcon;
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;

const PATHS: Record<PmPageIcon, string[]> = {
  folder: [
    'M3 7.5A2.5 2.5 0 0 1 5.5 5h3.2l2 2h7.8A2.5 2.5 0 0 1 21 9.5v7A2.5 2.5 0 0 1 18.5 19h-13A2.5 2.5 0 0 1 3 16.5Z',
  ],
  calendar: [
    'M4 7.5A2.5 2.5 0 0 1 6.5 5h11A2.5 2.5 0 0 1 20 7.5v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z',
    'M8 3v4',
    'M16 3v4',
    'M4 10h16',
  ],
  file: ['M7 3.5h6.5L18 8v12.5H7Z', 'M13.5 3.5V8H18', 'M10 12.5h5', 'M10 16h5'],
  bug: [
    'M8.5 9.5h7V14a3.5 3.5 0 0 1-7 0Z',
    'M9.5 6.2 12 8l2.5-1.8',
    'M4.5 13H8.5',
    'M15.5 13h4',
    'M6 18.5l2-2',
    'M18 18.5l-2-2',
  ],
};
---

<header class="mb-5 flex shrink-0 items-start gap-3">
  <span class="tw-pm-page-ico" aria-hidden="true">
    <svg
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      {PATHS[icon].map((d) => (
        <path d={d} />
      ))}
    </svg>
  </span>
  <div class="min-w-0">
    <h1 class="text-lg font-semibold text-stone-800">{title}</h1>
    <p class="mt-0.5 text-xs leading-relaxed text-stone-400">{description}</p>
  </div>
</header>
