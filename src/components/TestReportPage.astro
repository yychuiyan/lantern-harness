---
import Base from '../layouts/Base.astro';
import HydrateCache from './HydrateCache.astro';
import TestReportsLibrary from './islands/TestReportsLibrary';

interface Props {
  title: string;
  description: string;
  fixedKind: 'functional' | 'api' | 'perf';
}

const { title, description, fixedKind } = Astro.props;
---

<Base title={`${title} · Lantern Harness`}>
  <div class="tw-library-page tw-library-wide px-8 py-8">
    <header class="mb-6 shrink-0">
      <h1 class="text-2xl font-bold text-stone-900">{title}</h1>
      <p class="mt-2 text-sm text-stone-500">{description}</p>
    </header>
    <div class="tw-hydrate-host">
      <TestReportsLibrary client:only="react" fixedKind={fixedKind} />
      <HydrateCache host=".tw-hydrate-host" name={`testReports-${fixedKind}`} capture />
    </div>
  </div>
</Base>
