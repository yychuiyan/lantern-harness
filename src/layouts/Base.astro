---
import { ClientRouter, fade } from 'astro:transitions';
import '../styles/global.css';
import '../styles/docs-article.css';
import NavLibraries from '../components/islands/NavLibraries';
import HydrateCache from '../components/HydrateCache.astro';
import SettingsDialog from '../components/islands/SettingsDialog';
import SpaceSwitcher from '../components/islands/SpaceSwitcher';
import { GlobalToastHost } from '../components/islands/Toast';
import { APP_NAME } from '../lib/brand';
import { APP_VERSION } from '../lib/app-version';

interface Props {
  title?: string;
  /** 主内容区过渡：none 用于帮助中心文档（避免滚到底切页时叠影） */
  mainTransition?: 'fade' | 'none';
}

const { title = APP_NAME, mainTransition = 'fade' } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;

/** 工作台在 /workbench/；站点根 / 会跳到工作台 */
function isHome(): boolean {
  const stripped = path.replace(/\/$/, '');
  return stripped === `${base.replace(/\/$/, '')}/workbench`;
}

function pathHas(seg: string): boolean {
  // 按路径段匹配，避免 /pm/requirements/ 把「需求文档库」也点亮
  const root = base.replace(/\/$/, '');
  const rest = path.slice(root.length).replace(/^\/+/, '');
  return rest === seg || rest.startsWith(`${seg}/`);
}

const navItem = (active: boolean) =>
  ['tw-nav-item', active ? 'is-active font-medium' : ''].filter(Boolean).join(' ');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}brand/favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}brand/apple-touch-icon.png`} />
    <title>{title}</title>
    <script is:inline>
      // 尽早禁用滚动恢复，避免整页跳转/切页时停在旧滚动位置造成文字叠影
      try {
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      } catch (e) {}
    </script>
    <script>
      // 全局悬浮提示（data-hint）：监听器挂在 document 上，软导航后依然生效。
      // 注意 import 必须写在本脚本内：Astro 的 <script> 是独立客户端模块，
      // 拿不到 frontmatter 的顶部 import。
      import { initHintTips } from '../lib/hint-tip';
      import { initPluginNav } from '../lib/plugin-nav';
      import { initUpdateBadge } from '../lib/update-badge';
      initHintTips();
      initPluginNav();
      initUpdateBadge();
    </script>
    <ClientRouter />
    <script is:inline>
      (function () {
        try {
          // 配置按空间分键（`tw.app.config.v1::<spaceId>`），主题必须从同一个键读，
          // 否则深色下刷新会先按浅色画一帧、等脚本跑完才变黑（闪白）。
          var earlySpaceId = (
            sessionStorage.getItem('tw.space.active-id') ||
            localStorage.getItem('tw.space.active-id') ||
            ''
          ).trim();
          var raw =
            (earlySpaceId ? localStorage.getItem('tw.app.config.v1::' + earlySpaceId) : null) ||
            localStorage.getItem('tw.app.config.v1');
          var cfg = raw ? JSON.parse(raw) : null;
          var g = (cfg && cfg.general) || {};
          var root = document.documentElement;
          if (raw) {
            var size = typeof g.sessionFontSize === 'number' ? Math.round(g.sessionFontSize) : 14;
            if (size < 12) size = 12;
            if (size > 22) size = 22;
            var px = size + 'px';
            root.style.setProperty('--tw-ui-font-size', px);
            root.style.setProperty('--tw-session-font-size', px);
            if (g.language === 'en') root.lang = 'en';
          }
          // 没有配置时按系统偏好定主题：早一帧定下来，页面就不会先亮后暗
          var appearance = g.appearance;
          var theme =
            appearance === 'dark' || appearance === 'light'
              ? appearance
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
          if (localStorage.getItem('tw.nav.collapsed') === '1') {
            document.documentElement.dataset.navCollapsed = '1';
          }
          var spaceId = earlySpaceId;
          var cfgKey = spaceId ? 'tw.app.config.v1::' + spaceId : 'tw.app.config.v1';
          var cfgRaw = localStorage.getItem(cfgKey) || localStorage.getItem('tw.app.config.v1');
          if (cfgRaw) {
            var savedCfg = JSON.parse(cfgRaw) || {};
            var plugins = savedCfg.plugins || {};
            if (plugins.cases === false) document.documentElement.dataset.pluginOffCases = '1';
            if (plugins.todos === false) document.documentElement.dataset.pluginOffTodos = '1';
            if (plugins.tasks === false) document.documentElement.dataset.pluginOffTasks = '1';
            if (plugins.projects !== true) document.documentElement.dataset.pluginOffProjects = '1';
            if (plugins.iterations !== true)
              document.documentElement.dataset.pluginOffIterations = '1';
            if (plugins.pmRequirements !== true)
              document.documentElement.dataset.pluginOffPmRequirements = '1';
            if (plugins.bugs !== true) document.documentElement.dataset.pluginOffBugs = '1';
            if (plugins.reports !== true) document.documentElement.dataset.pluginOffReports = '1';
            if (plugins.testStats !== true)
              document.documentElement.dataset.pluginOffTestStats = '1';
            if (plugins.caseExec !== true) document.documentElement.dataset.pluginOffCaseExec = '1';
            if (plugins.dashboard !== true)
              document.documentElement.dataset.pluginOffDashboard = '1';
            if (plugins.knowledgeLib === false)
              document.documentElement.dataset.pluginOffKnowledgeLib = '1';
            if (plugins.requirements === false)
              document.documentElement.dataset.pluginOffRequirements = '1';
            if (plugins.templates === false)
              document.documentElement.dataset.pluginOffTemplates = '1';
            // 本地已有菜单布局：静态占位（固定顺序平铺）不再亮相，避免闪一下「排序前」
            if (Array.isArray(savedCfg.navGroups) || Array.isArray(savedCfg.navOrder)) {
              document.documentElement.dataset.navCached = '1';
              // 兜底：脚本没跑起来（岛始终为空）时把占位放回来，别让侧栏彻底空着
              window.setTimeout(function () {
                var island = document.querySelector('.tw-nav-libraries astro-island');
                if (!island || !island.querySelector('.tw-nav-item-main')) {
                  document.documentElement.removeAttribute('data-nav-cached');
                }
              }, 3000);
            }
          }
          // 有了侧栏刷新缓存（上次真实渲染的 DOM）也不必再摆平铺占位：
          // 否则收起的分组会先以「平铺展开」的样子闪一下再变成分组
          try {
            var navCacheKey = spaceId ? 'tw.hydrate.nav::' + spaceId : 'tw.hydrate.nav';
            if (localStorage.getItem(navCacheKey)) {
              document.documentElement.dataset.navCached = '1';
              window.setTimeout(function () {
                var island = document.querySelector('.tw-nav-libraries astro-island');
                if (!island || !island.querySelector('.tw-nav-item-main')) {
                  document.documentElement.removeAttribute('data-nav-cached');
                }
              }, 3000);
            }
          } catch (e) {
            /* ignore */
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="tw-body antialiased">
    <div class="tw-shell min-h-screen">
      <aside class="tw-nav-aside fixed inset-y-0 left-0 flex flex-col z-45" id="tw-nav-aside">
        <div class="tw-nav-brand">
          <div class="tw-nav-brand-row">
            <a href={base} class="tw-nav-brand-link min-w-0 flex-1" data-astro-reload>
              <span class="tw-nav-brand-mark" aria-hidden="true">
                <img
                  class="tw-nav-brand-mark-img"
                  src={`${base}brand/brand-mark.png`}
                  alt=""
                  width="36"
                  height="36"
                />
              </span>
              <span class="tw-nav-brand-text">
                <span class="tw-nav-brand-title-row">
                  <span class="tw-nav-brand-title" data-i18n="nav.brand">
                    {APP_NAME}
                  </span>
                  <span class="tw-nav-brand-ver" data-hint={`平台版本 v${APP_VERSION}`}>
                    v{APP_VERSION}
                    <span
                      class="tw-nav-brand-dot"
                      id="tw-update-dot"
                      role="button"
                      tabindex="-1"
                      aria-label="有新版本可更新"
                      hidden
                    ></span>
                  </span>
                </span>
              </span>
            </a>
          </div>
        </div>

        {/* 数据空间切换器：骨架先占位（同高），岛屿渲染后由 CSS 隐藏 */}
        <div class="tw-nav-space-slot">
          <div class="tw-nav-space tw-nav-space-ph" id="tw-nav-space-ph" aria-hidden="true">
            <div class="tw-nav-space-ph-box">
              <span class="tw-nav-space-ph-ico"></span>
              <span class="tw-nav-space-ph-lines">
                <span class="tw-nav-space-ph-bar is-cap"></span>
                <span class="tw-nav-space-ph-bar is-name"></span>
              </span>
            </div>
          </div>
          <SpaceSwitcher client:only="react" transition:persist />
        </div>

        <button
          type="button"
          id="tw-nav-toggle"
          class="tw-nav-toggle"
          aria-label="收起或展开左侧导航"
          aria-expanded="true"
          aria-controls="tw-nav-aside"
        >
          <svg
            class="tw-nav-toggle-icon is-collapse"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 6l-6 6 6 6"></path>
          </svg>
          <svg
            class="tw-nav-toggle-icon is-expand"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 6l6 6-6 6"></path>
          </svg>
        </button>

        <nav class="tw-nav-list flex-1 overflow-y-auto">
          <a
            href={`${base}workbench/`}
            class={navItem(isHome())}
            data-i18n-hint="nav.home"
            data-hint="我的工作台"
          >
            <svg
              class="tw-nav-ico"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              aria-hidden="true"
            >
              <path d="M3 10.5 12 3l9 7.5"></path>
              <path d="M5 9.5V20h14V9.5"></path>
            </svg>
            <span class="tw-nav-label" data-i18n="nav.home">
              我的工作台
            </span>
          </a>

          <div class="tw-nav-libraries">
            <div class="tw-nav-libraries-ph">
              <a
                href={`${base}dashboard/`}
                class={navItem(pathHas('dashboard'))}
                data-plugin-nav="dashboard"
              >
                <svg
                  class="tw-nav-ico"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                  <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                  <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                  <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                </svg>
                <span class="tw-nav-label" data-i18n="nav.dashboard">
                  仪表盘
                </span>
              </a>
              <a href={`${base}tasks/`} class={navItem(pathHas('tasks'))} data-plugin-nav="tasks">
                <svg
                  class="tw-nav-ico"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <path d="M9 5h10"></path>
                  <path d="M9 12h10"></path>
                  <path d="M9 19h10"></path>
                  <path d="M4 5h.01"></path>
                  <path d="M4 12h.01"></path>
                  <path d="M4 19h.01"></path>
                </svg>
                <span class="tw-nav-label" data-i18n="nav.tasks">
                  任务管理
                </span>
              </a>
              <a href={`${base}todos/`} class={navItem(pathHas('todos'))} data-plugin-nav="todos">
                <svg
                  class="tw-nav-ico"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <path d="M8 6h13"></path>
                  <path d="M8 12h13"></path>
                  <path d="M8 18h13"></path>
                  <path d="M3 6h.01"></path>
                  <path d="M3 12h.01"></path>
                  <path d="M3 18h.01"></path>
                </svg>
                <span class="tw-nav-label" data-i18n="nav.todos">
                  待办事项
                </span>
              </a>
              <a
                href={`${base}pm/projects/`}
                class={navItem(pathHas('pm/projects'))}
                data-plugin-nav="projects"
              >
                <svg
                  class="tw-nav-ico"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"></path>
                </svg>
                <span class="tw-nav-label" data-i18n="nav.projects">
                  项目列表
                </span>
              </a>
              <a
                href={`${base}pm/iterations/`}
                class={navItem(pathHas('pm/iterations'))}
                data-plugin-nav="iterations"
              >
                <svg
                  class="tw-nav-ico"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                  <path d="M8 3v4"></path>
                  <path d="M16 3v4"></path>
                  <path d="M3 10h18"></path>
                </svg>
                <span class="tw-nav-label" data-i18n="nav.iterations">
                  迭代管理
                </span>
              </a>
              <a
                href={`${base}pm/requirements/`}
                class={navItem(pathHas('pm/requirements'))}
                data-plugin-nav="pmRequirements"
              >
                <svg
                  class="tw-nav-ico"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <path d="M14 3v5h5"></path>
                  <path d="M6 2h8l6 6v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"></path>
                  <path d="M8 13h8"></path>
                  <path d="M8 17h5"></path>
                </svg>
                <span class="tw-nav-label" data-i18n="nav.requirementsMgmt">
                  需求管理
                </span>
              </a>
              <a
                href={`${base}pm/bugs/`}
                class={navItem(pathHas('pm/bugs'))}
                data-plugin-nav="bugs"
              >
                <svg
                  class="tw-nav-ico"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="14" r="5"></circle>
                  <path d="M9 6l2 2"></path>
                  <path d="M15 6l-2 2"></path>
                  <path d="M7 11H4"></path>
                  <path d="M20 11h-3"></path>
                  <path d="M7 17H4"></path>
                  <path d="M20 17h-3"></path>
                </svg>
                <span class="tw-nav-label" data-i18n="nav.bugs">
                  缺陷管理
                </span>
              </a>
              <a
                href={`${base}reports/`}
                class={navItem(pathHas('reports'))}
                data-plugin-nav="reports"
              >
                <svg
                  class="tw-nav-ico"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <path d="M14 3v5h5"></path>
                  <path d="M6 2h8l6 6v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"></path>
                  <path d="M8 13h8"></path>
                  <path d="M8 17h5"></path>
                </svg>
                <span class="tw-nav-label" data-i18n="nav.reports">
                  工作汇报
                </span>
              </a>
              <a
                href={`${base}test-stats/`}
                class={navItem(pathHas('test-stats'))}
                data-plugin-nav="testStats"
              >
                <svg
                  class="tw-nav-ico"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <path d="M4 20V10"></path>
                  <path d="M10 20V4"></path>
                  <path d="M16 20v-7"></path>
                  <path d="M22 20H2"></path>
                </svg>
                <span class="tw-nav-label" data-i18n="nav.testStats">
                  测试统计
                </span>
              </a>
              <a
                href={`${base}case-exec/`}
                class={navItem(pathHas('case-exec'))}
                data-plugin-nav="caseExec"
              >
                <svg
                  class="tw-nav-ico"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="9"></circle>
                  <circle cx="12" cy="12" r="5"></circle>
                  <circle cx="12" cy="12" r="1.4"></circle>
                </svg>
                <span class="tw-nav-label" data-i18n="nav.caseExec">
                  用例执行统计
                </span>
              </a>
              <a
                href={`${base}cases/library/`}
                class={navItem(pathHas('cases'))}
                data-plugin-nav="cases"
              >
                <svg
                  class="tw-nav-ico"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <path d="M9 11l3 3L22 4"></path>
                  <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                </svg>
                <span class="tw-nav-label" data-i18n="nav.caseManage">
                  用例管理
                </span>
              </a>
              <a
                href={`${base}knowledge/`}
                class={navItem(pathHas('knowledge'))}
                data-plugin-nav="knowledgeLib"
              >
                <svg
                  class="tw-nav-ico"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                  <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                </svg>
                <span class="tw-nav-label" data-i18n="nav.knowledge">
                  知识库管理
                </span>
              </a>
              <a
                href={`${base}requirements/`}
                class={navItem(pathHas('requirements'))}
                data-plugin-nav="requirements"
                data-i18n-hint="nav.requirements"
              >
                <svg
                  class="tw-nav-ico"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <path d="M14 3v5h5"></path>
                  <path d="M6 2h8l6 6v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"></path>
                  <path d="M8 13h8"></path>
                  <path d="M8 17h6"></path>
                </svg>
                <span class="tw-nav-label" data-i18n="nav.requirements">
                  需求文档库
                </span>
              </a>
              <a
                href={`${base}templates/`}
                class={navItem(pathHas('templates'))}
                data-plugin-nav="templates"
                data-i18n-hint="nav.templates"
              >
                <svg
                  class="tw-nav-ico"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <path d="M12 3 3 8l9 5 9-5-9-5z"></path>
                  <path d="m3 13 9 5 9-5"></path>
                </svg>
                <span class="tw-nav-label" data-i18n="nav.templates">
                  测试模板库
                </span>
              </a>
            </div>
            <NavLibraries client:only="react" transition:persist />
            <HydrateCache host=".tw-nav-libraries" name="nav" fixActive syncNavGroups />
          </div>

          {/* 固定入口：提示词管理始终贴在帮助中心上方，不参与分组 / 排序 */}
          <a
            href={`${base}prompts/`}
            class={navItem(pathHas('prompts'))}
            data-plugin-nav="prompts"
            data-pinned-nav="prompts"
          >
            <svg
              class="tw-nav-ico"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              aria-hidden="true"
            >
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
            </svg>
            <span class="tw-nav-label" data-i18n="nav.prompts">
              提示词管理
            </span>
          </a>

          <a
            href={`${base}docs/manual/`}
            class={navItem(pathHas('docs'))}
            data-hint="帮助中心"
            data-i18n-hint="nav.helpCenter"
          >
            <svg
              class="tw-nav-ico"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              aria-hidden="true"
            >
              <path d="M5 4.5h9.5L19 9v10.5H5V4.5Z" stroke-linejoin="round"></path>
              <path d="M14.5 4.5V9H19" stroke-linejoin="round"></path>
              <path d="M8 13h8M8 16.5h6" stroke-linecap="round"></path>
            </svg>
            <span class="tw-nav-label" data-i18n="nav.helpCenter">
              帮助中心
            </span>
          </a>
        </nav>

        <div class="tw-nav-foot">
          <SettingsDialog client:load />
        </div>
      </aside>

      {/* 侧栏模型名：SSR 只能画「未配置」，这里在首屏解析阶段先用本地缓存改掉，
          避免刷新时先闪一下「未配置」；缓存与岛屿首帧同源，hydration 不会打架。 */}
      <script is:inline data-astro-rerun>
        (function () {
          try {
            var raw = localStorage.getItem('tw.app.model.v1');
            if (!raw) return;
            var model = JSON.parse(raw) || {};
            var list = Array.isArray(model.providers) ? model.providers : [];
            var active = null;
            for (var i = 0; i < list.length; i++) {
              if (list[i] && list[i].id === model.activeId) {
                active = list[i];
                break;
              }
            }
            if (!active && list.length) active = list[0];
            var name = active && active.name ? String(active.name).trim() : '';
            if (!name) return;
            var el = document.querySelector('.tw-nav-provider-name');
            if (!el) return;
            el.textContent = name;
            var chip = el.closest('.tw-nav-provider-chip');
            if (chip) {
              chip.classList.remove('is-empty');
              var m = active.model ? ' · ' + String(active.model).trim() : '';
              chip.setAttribute('data-hint', name + m);
            }
          } catch (e) {
            /* ignore */
          }
        })();
      </script>
      <script is:inline data-astro-rerun>
        (function () {
          var root = document.documentElement;
          var btn = document.getElementById('tw-nav-toggle');
          function apply(collapsed) {
            if (collapsed) root.dataset.navCollapsed = '1';
            else delete root.dataset.navCollapsed;
            try {
              localStorage.setItem('tw.nav.collapsed', collapsed ? '1' : '0');
            } catch (e) {}
            if (btn) {
              btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
              // 气泡已移除；改为动态更新不可见标签，读屏仍能获知当前动作
              btn.setAttribute('aria-label', collapsed ? '展开导航' : '收起导航');
            }
          }
          apply(root.dataset.navCollapsed === '1');
          if (btn) {
            btn.addEventListener('click', function () {
              apply(root.dataset.navCollapsed !== '1');
            });
          }

          try {
            var raw = localStorage.getItem('tw.app.config.v1');
            if (!raw) return;
            var g = JSON.parse(raw).general || {};
            if (g.language !== 'en') return;
            var en = {
              'nav.brand': 'Lantern Harness',
              'nav.home': 'My Workbench',
              'nav.dashboard': 'Dashboard',
              'nav.tasks': 'Tasks',
              'nav.todos': 'Todos',
              'nav.projects': 'Projects',
              'nav.iterations': 'Iterations',
              'nav.requirementsMgmt': 'Requirements Mgmt',
              'nav.bugs': 'Bugs',
              'nav.reports': 'Work Report',
              'nav.testStats': 'Test Statistics',
              'nav.caseExec': 'Case Execution',
              'nav.uiAuto': 'Automation Testing',
              'nav.reqAnalysis': 'Requirement Analysis',
              'nav.caseManage': 'Test Cases',
              'nav.prompts': 'Prompts',
              'nav.knowledge': 'Knowledge Mgmt',
              'nav.plugins': 'My Plugins',
              'nav.docs': 'Documents',
              'nav.requirements': 'Requirements',
              'nav.templates': 'Test Templates',
              'nav.settings': 'Settings',
              'nav.changelog': 'Changelog',
              'nav.changelogShort': 'Changelog',
              'nav.helpCenter': 'Help Center',
              'docs.nav.title': 'Docs',
              'docs.nav.changelog': 'Changelog',
              'docs.nav.manual': 'User Guide',
              'docs.nav.install': 'Install Guide',
              'nav.repo': 'GitHub',
              'nav.repoShort': 'Repo',
              'nav.npm': 'npm package',
              'nav.npmShort': 'npm',
              'nav.site': 'Yycy Docs',
              'nav.siteShort': 'Site',
              'nav.board': 'Questions & suggestions',
              'nav.boardShort': 'Suggestions',
            };
            document.querySelectorAll('[data-i18n]').forEach(function (el) {
              var key = el.getAttribute('data-i18n');
              if (key && en[key]) el.textContent = en[key];
            });
            document.querySelectorAll('[data-i18n-hint]').forEach(function (el) {
              var key = el.getAttribute('data-i18n-hint');
              if (key && en[key]) el.setAttribute('data-hint', en[key]);
            });
          } catch (e) {}
        })();
      </script>
      {mainTransition === 'none' ? (
        <main class="tw-main min-h-screen" transition:animate="none">
          <div
            id="tw-route-loading"
            class="tw-route-loading is-hidden"
            role="status"
            aria-live="polite"
            aria-label="页面加载中"
          >
            <span class="tw-route-loading-spin" aria-hidden="true"></span>
          </div>
          <slot />
        </main>
      ) : (
        <main class="tw-main min-h-screen" transition:animate={fade({ duration: '180ms' })}>
          <div
            id="tw-route-loading"
            class="tw-route-loading is-hidden"
            role="status"
            aria-live="polite"
            aria-label="页面加载中"
          >
            <span class="tw-route-loading-spin" aria-hidden="true"></span>
          </div>
          <slot />
        </main>
      )}
      <GlobalToastHost client:only="react" transition:persist />
    </div>
    <script is:inline>
      (function () {
        /**
         * 切页滚回顶部。
         * 只在「换页后」重置：若在 before-preparation（点击瞬间）就重置，
         * 当前页面会先跳回顶部、再等新页到达，用户看到的就是「打开时还在滚动」。
         * 带锚点（#）时交给浏览器定位，不强制回顶。
         */
        try {
          if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        } catch (e) {}
        function twScrollTop() {
          if (location.hash) return;
          if (window.scrollY === 0 && document.documentElement.scrollTop === 0) return;
          try {
            // instant：不受将来可能加入的 scroll-behavior: smooth 影响
            window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
          } catch (e) {
            // 旧浏览器不认 instant，会抛 TypeError，退回普通写法
            window.scrollTo(0, 0);
          }
          document.documentElement.scrollTop = 0;
          document.body.scrollTop = 0;
          var main = document.querySelector('.tw-main');
          if (main) main.scrollTop = 0;
        }
        document.addEventListener('astro:after-swap', twScrollTop);
        document.addEventListener('astro:page-load', twScrollTop);

        /**
         * 软导航「闪白」修复。
         * ClientRouter 交换文档时，会用新文档 <html> 的属性整体替换当前 <html>，
         * 于是 data-theme 连同 style 里的 color-scheme 一起被清空；在主题属性
         * 恢复之前，color-scheme 回落到 normal，画布变白 —— 深色主题下就是
         * 切页瞬间的闪白（与具体页面无关，所有路由都受影响）。
         * 在交换前把主题 / 语言写进新文档的 <html>，交换完成时即已带上，不留空档。
         */
        document.addEventListener('astro:before-swap', function (e) {
          var next = e.newDocument;
          if (!next || !next.documentElement) return;
          var cur = document.documentElement;
          var nextRoot = next.documentElement;
          var theme = cur.dataset.theme;
          if (theme) {
            nextRoot.dataset.theme = theme;
            nextRoot.style.colorScheme = theme;
          }
          if (cur.lang) nextRoot.lang = cur.lang;
          // 新文档是「解析」出来的：head 里的内联脚本在解析阶段不会执行，
          // 于是所有运行期写在 <html> 上的状态都不会自带。主题 / 语言之外，
          // 侧栏收起状态与空间服务可用性同样要显式搬过去，否则每次软导航都会丢
          // （表现为侧栏自己弹开、骨架又冒出来）。
          if (cur.dataset.navCollapsed === '1') nextRoot.dataset.navCollapsed = '1';
          if (cur.dataset.spaceService) nextRoot.dataset.spaceService = cur.dataset.spaceService;
          // 插件开关同理：不搬过去会先亮出被隐藏的侧栏入口，等 page-load 再收起
          [
            'pluginOffTasks',
            'pluginOffTodos',
            'pluginOffProjects',
            'pluginOffIterations',
            'pluginOffPmRequirements',
            'pluginOffBugs',
            'pluginOffReports',
            'pluginOffTestStats',
            'pluginOffCaseExec',
            'pluginOffDashboard',
            'pluginOffCases',
            'pluginOffKnowledgeLib',
            'pluginOffRequirements',
            'pluginOffTemplates',
          ].forEach(function (key) {
            if (cur.dataset[key]) nextRoot.dataset[key] = cur.dataset[key];
          });
        });

        /** 版本日志「查看更多」：委托绑定，兼容 View Transitions 软导航 */
        document.addEventListener('click', function (e) {
          var t = e.target;
          if (!(t instanceof Element)) return;
          var btn = t.closest('.tw-changelog-toggle');
          if (!(btn instanceof HTMLButtonElement)) return;
          var card = btn.closest('.tw-changelog-card');
          if (!(card instanceof HTMLElement)) return;
          e.preventDefault();
          var next = card.getAttribute('data-open') !== 'true';
          card.setAttribute('data-open', next ? 'true' : 'false');
          btn.setAttribute('aria-expanded', next ? 'true' : 'false');
          var label = btn.querySelector('.tw-changelog-toggle-label');
          if (label) label.textContent = next ? '收起' : '查看更多';
        });
      })();
    </script>
  </body>
</html>
