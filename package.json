{
  "name": "lantern-harness",
  "version": "0.1.15",
  "license": "MIT",
  "type": "module",
  "description": "AI 工作台：对话与插件工具、内容库、模板库、会话记忆，数据留在本机。",
  "keywords": [
    "ai",
    "ai-workbench",
    "local-first",
    "byok",
    "plugins",
    "knowledge-base",
    "prompt-library",
    "memory",
    "lantern",
    "lantern-harness",
    "AI 工作台",
    "本地 AI 工作台",
    "数据留在本机",
    "插件化",
    "内容库",
    "知识库",
    "提示词",
    "会话记忆"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yychuiyan/lantern-harness.git"
  },
  "homepage": "https://github.com/yychuiyan/lantern-harness#readme",
  "bin": {
    "lantern": "cli/lantern.mjs"
  },
  "files": [
    "dist",
    "cli",
    "builtin",
    "lh-plugins",
    "config",
    "docs",
    "空间池/.gitkeep",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node cli/lantern.mjs web --foreground --dir .",
    "astro": "astro",
    "lint": "eslint src --max-warnings 50",
    "lint:fix": "eslint src --fix",
    "test": "tsx --test src/**/*.test.ts",
    "pretest": "node -e \"const [a,b]=process.versions.node.split('.').map(Number); if(a<22||(a===22&&b<22)){console.error('需要 Node >= 22.22.0（当前 '+process.version+'）：低版本 node:test 不执行顶层 before/after，测试会写入真实空间池'); process.exit(1)}\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,astro,css,md,json}\" \"*.{md,json,mjs,js}\" \"cli/**/*.mjs\" \"builtin/**/*.mjs\" \"lh-plugins/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,astro,css,md,json}\" \"*.{md,json,mjs,js}\" \"cli/**/*.mjs\" \"builtin/**/*.mjs\" \"lh-plugins/**/*.mjs\"",
    "prepare": "simple-git-hooks && node cli/ensure-dist.mjs",
    "prepublishOnly": "pnpm build"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,astro,css,md,json}": [
      "prettier --write"
    ],
    "src/**/*.{ts,tsx}": [
      "eslint --max-warnings 50 --no-warn-ignored"
    ],
    "cli/**/*.mjs": [
      "prettier --write"
    ],
    "builtin/**/*.mjs": [
      "prettier --write"
    ],
    "lh-plugins/**/*.mjs": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@headlessui/react": "^2.2.10",
    "astro": "^7.4.0",
    "connect": "^3.7.0",
    "dompurify": "^3.2.4",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "marked": "^15.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-grid-layout": "2.3.0",
    "sirv": "^3.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.0.0",
    "@types/connect": "^3.4.38",
    "@types/dompurify": "^3.0.5",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
